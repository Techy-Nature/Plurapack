{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Plurapack",
  "version": "0.1.0",
  "identifier": "app.plurapack.dashboard",
  "build": {
    "frontendDist": "../launcher"
  },
  "app": {
    "windows": [
      {
        "title": "Plurapack",
        "width": 1200,
        "height": 800,
        "minWidth": 360,
        "minHeight": 520,
        "theme": "Dark",
        "backgroundColor": "#0b1017"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "SocialNetworking",
    "shortDescription": "Plurapack dashboard",
    "longDescription": "Manage your Plurapack system, members, groups, fronts and API tokens.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
