STOAT_BOT_TOKEN=replace-me
# Optional: set this as well to connect the same process to both platforms.
FLUXER_BOT_TOKEN=
PLURAPACK_PREFIX=p;
PLURAPACK_DATABASE=plurapack.sqlite3
# Full protected Modal Chatterbox Turbo v03 HTTP endpoint.
PLURAPACK_TTS_URL=
# Modal proxy token (wk-....ws-....), used only for server-to-server TTS invocation.
PLURAPACK_TTS_API_KEY=
PLURAPACK_TTS_QUEUE_LIMIT=8
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
PLURAPACK_SESSION_SECRET=replace-with-at-least-32-random-characters
# Keep true behind production HTTPS. Set false only for local HTTP development.
PLURAPACK_COOKIE_SECURE=true
# Maximum login codes created per directly connected client per minute.
PLURAPACK_LOGIN_START_LIMIT=10
PLURAPACK_WEB_HOST=127.0.0.1
PLURAPACK_WEB_PORT=8000
# Private voice WAV storage. Plurapack uploads/deletes with a WRITE-capable Forgejo
# credential; Modal uses its own separate READ-ONLY token to fetch references.
VOICE_STORAGE_PROVIDER=forgejo
VOICE_FORGEJO_BASE_URL=https://git.gay
VOICE_FORGEJO_OWNER=TechyNestBots
VOICE_FORGEJO_REPO=plurapack-voice-index
VOICE_FORGEJO_BRANCH=main
# Forgejo credential used only by Plurapack to upload/delete private custom WAVs.
VOICE_STORAGE_API_KEY=
VOICE_MAX_UPLOAD_BYTES=26214400
VOICE_MAX_REFERENCE_SECONDS=30
